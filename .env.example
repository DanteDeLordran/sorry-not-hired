DOCKER_IMAGE_BACKEND=sorry-not-hired-backend
DOCKER_IMAGE_FRONTEND=sorry-not-hired-frontend
TAG=1.0.0

# Start the bundled model services. Set to an empty value for a hosted API.
COMPOSE_PROFILES=ollama

# DeepSeek: set COMPOSE_PROFILES= above and uncomment these three lines.
# API_KEY=your-deepseek-api-key
# BASE_URL=https://api.deepseek.com
# CHAT_MODEL=deepseek-v4-pro

# LM Studio on the host: set COMPOSE_PROFILES= and use these instead.
# API_KEY=lm_studio
# BASE_URL=http://host-gateway:1234/v1
# CHAT_MODEL=your-model-name

# Required by compose.production.yml and compose.coolify.yml for HTTPS:
# PUBLIC_HOST=roast.example.com
